 <style>
    .modale
    {
        position: fixed;
        top: 0;
        left: 0;
        background-color: black;
        z-index: 99;
        opacity: 0.5;
        filter: alpha(opacity=80);
        -moz-opacity: 0.8;
        min-height: 100%;
        width: 100%;
    }
       .loading
    {
        font-family: Arial;
        font-size: 10pt;
        border: 5px solid;
        width: 300px;
        height: 130px;
        display: none;
        position: fixed;
        background-color: White;
        z-index: 999;
        border-color:#D9D9D9; border-radius:0%
    }

    #adminpanel:hover {
        background-color:rgb(0,177,168)
            
