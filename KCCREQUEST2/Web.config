    <add name="developpers_dbEntities" connectionString="metadata=res://*/DeveloperDB.csdl|res://*/DeveloperDB.ssdl|res://*/DeveloperDB.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=CDKTGSVC9DB0034;initial catalog=AppDev_Developers_DB;persist security info=True;user id=svc-cd-ktg-devdbt;password=Bdoj821_;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
